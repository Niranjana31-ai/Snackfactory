    function isValidInvoiceItem(data, itemId) {
      return data.keys().hasAll([
        'id', 'orgId', 'invoiceId', 'salesOrderId', 'salesmanUid', 'productId', 'productName',
        'productSku', 'packetSize', 'hsnCode', 'quantity', 'rate', 'taxableValue', 'gstPercentage',
