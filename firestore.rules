rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedOwner() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email == '727824tuad139@skct.edu.in';
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function callerUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveErpUser() {
      return isBootstrappedOwner() || (
        isSignedIn() &&
        userDocExists() &&
        callerUser().status == 'Active'
      );
    }

    function hasRole(allowedRoles) {
      return isBootstrappedOwner() || (
        isActiveErpUser() &&
        callerUser().role in allowedRoles
      );
    }

    function isOwnerOrAdmin() {
      return hasRole(['Owner', 'Admin']);
    }

    function isValidRole(role) {
      return role is string && role in [
        'Owner',
        'Admin',
        'Salesman',
        'Production Supervisor',
        'Accountant/Auditor'
      ];
    }

    function isValidStatus(status) {
      return status is string && status in ['Active', 'Suspended'];
    }

    function isValidUsername(username) {
      return username is string &&
        username.size() >= 3 &&
        username.size() <= 30 &&
        username.matches('^[a-z0-9._\\-]+$');
    }

    function isValidUser(data, userId) {
      return data.keys().hasAll([
        'uid',
        'displayName',
        'email',
        'role',
        'department',
        'status',
        'createdAt',
        'updatedAt',
        'lastLoginAt'
      ]) &&
      data.keys().hasOnly([
        'uid',
        'username',
        'displayName',
        'email',
        'photoURL',
        'role',
        'department',
        'status',
        'createdAt',
        'updatedAt',
        'lastLoginAt'
      ]) &&
      data.uid is string &&
      data.uid == userId &&
      isValidId(data.uid) &&
      (!('username' in data) || isValidUsername(data.username)) &&
      data.displayName is string &&
      data.displayName.size() >= 1 &&
      data.displayName.size() <= 100 &&
      data.email is string &&
      data.email.size() >= 3 &&
      data.email.size() <= 254 &&
      (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
      isValidRole(data.role) &&
      data.department is string &&
      data.department.size() >= 1 &&
      data.department.size() <= 80 &&
      isValidStatus(data.status) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp &&
      data.lastLoginAt is timestamp;
    }

    function isValidGstin(gstin) {
      return gstin is string && (
        gstin.size() == 0 ||
        (gstin.size() == 15 && gstin.matches('^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$'))
      );
    }

    function isValidProduct(data, productId) {
      return data.keys().hasAll([
        'id',
        'orgId',
        'name',
        'sku',
        'category',
        'description',
        'packetSize',
        'sellingPrice',
        'gstPercentage',
        'status',
        'createdBy',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'orgId',
        'name',
        'sku',
        'category',
        'description',
        'packetSize',
        'sellingPrice',
        'gstPercentage',
        'hsnCode',
        'status',
        'createdBy',
        'createdAt',
        'updatedAt'
      ]) &&
      data.id is string &&
      data.id == productId &&
      isValidId(data.id) &&
      data.orgId == 'snackfactory' &&
      data.name is string &&
      data.name.size() >= 1 &&
      data.name.size() <= 120 &&
      data.sku is string &&
      data.sku.size() >= 1 &&
      data.sku.size() <= 40 &&
      data.sku.matches('^[A-Z0-9\\-_]+$') &&
      data.category is string &&
      data.category.size() >= 1 &&
      data.category.size() <= 60 &&
      data.description is string &&
      data.description.size() <= 500 &&
      data.packetSize is string &&
      data.packetSize.size() >= 1 &&
      data.packetSize.size() <= 30 &&
      (data.sellingPrice is int || data.sellingPrice is float) &&
      data.sellingPrice >= 0 &&
      data.sellingPrice <= 10000000 &&
      (data.gstPercentage is int || data.gstPercentage is float) &&
      data.gstPercentage >= 0 &&
      data.gstPercentage <= 28 &&
      (!('hsnCode' in data) || (data.hsnCode is string && data.hsnCode.size() <= 16 && data.hsnCode.matches('^[0-9A-Za-z]*$'))) &&
      data.status is string &&
      data.status in ['Active', 'Inactive'] &&
      data.createdBy is string &&
      isValidId(data.createdBy) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidRawMaterial(data, materialId) {
      return data.keys().hasAll([
        'id',
        'orgId',
        'name',
        'materialCode',
        'category',
        'unit',
        'openingStock',
        'currentStock',
        'purchasePrice',
        'minimumStockLevel',
        'createdBy',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'orgId',
        'name',
        'materialCode',
        'category',
        'unit',
        'openingStock',
        'currentStock',
        'purchasePrice',
        'minimumStockLevel',
        'createdBy',
        'createdAt',
        'updatedAt'
      ]) &&
      data.id is string &&
      data.id == materialId &&
      isValidId(data.id) &&
      data.orgId == 'snackfactory' &&
      data.name is string &&
      data.name.size() >= 1 &&
      data.name.size() <= 120 &&
      data.materialCode is string &&
      data.materialCode.size() >= 1 &&
      data.materialCode.size() <= 40 &&
      data.materialCode.matches('^[A-Z0-9\\-_]+$') &&
      data.category is string &&
      data.category.size() >= 1 &&
      data.category.size() <= 60 &&
      data.unit is string &&
      data.unit in ['kg', 'litre', 'pieces'] &&
      (data.openingStock is int || data.openingStock is float) &&
      data.openingStock >= 0 &&
      data.openingStock <= 100000000 &&
      (data.currentStock is int || data.currentStock is float) &&
      data.currentStock >= 0 &&
      data.currentStock <= 100000000 &&
      (data.purchasePrice is int || data.purchasePrice is float) &&
      data.purchasePrice >= 0 &&
      data.purchasePrice <= 10000000 &&
      (data.minimumStockLevel is int || data.minimumStockLevel is float) &&
      data.minimumStockLevel >= 0 &&
      data.minimumStockLevel <= 100000000 &&
      data.createdBy is string &&
      isValidId(data.createdBy) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidCustomer(data, customerId) {
      return data.keys().hasAll([
        'id',
        'orgId',
        'name',
        'contactPerson',
        'phone',
        'email',
        'gstin',
        'billingAddress',
        'state',
        'stateCode',
        'customerType',
        'createdBy',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'orgId',
        'name',
        'contactPerson',
        'phone',
        'email',
        'gstin',
        'billingAddress',
        'state',
        'stateCode',
        'customerType',
        'createdBy',
        'createdAt',
        'updatedAt'
      ]) &&
      data.id is string &&
      data.id == customerId &&
      isValidId(data.id) &&
      data.orgId == 'snackfactory' &&
      data.name is string &&
      data.name.size() >= 1 &&
      data.name.size() <= 120 &&
      data.contactPerson is string &&
      data.contactPerson.size() >= 1 &&
      data.contactPerson.size() <= 100 &&
      data.phone is string &&
      data.phone.size() >= 6 &&
      data.phone.size() <= 20 &&
      data.email is string &&
      data.email.size() <= 254 &&
      isValidGstin(data.gstin) &&
      data.billingAddress is string &&
      data.billingAddress.size() >= 1 &&
      data.billingAddress.size() <= 300 &&
      data.state is string &&
      data.state.size() >= 1 &&
      data.state.size() <= 60 &&
      data.stateCode is string &&
      data.stateCode.size() >= 1 &&
      data.stateCode.size() <= 5 &&
      data.customerType is string &&
      data.customerType in ['Retailer', 'Distributor'] &&
      data.createdBy is string &&
      isValidId(data.createdBy) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidSupplier(data, supplierId) {
      return data.keys().hasAll([
        'id',
        'orgId',
        'name',
        'contactPerson',
        'phone',
        'email',
        'gstin',
        'address',
        'state',
        'createdBy',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'orgId',
        'name',
        'contactPerson',
        'phone',
        'email',
        'gstin',
        'address',
        'state',
        'createdBy',
        'createdAt',
        'updatedAt'
      ]) &&
      data.id is string &&
      data.id == supplierId &&
      isValidId(data.id) &&
      data.orgId == 'snackfactory' &&
      data.name is string &&
      data.name.size() >= 1 &&
      data.name.size() <= 120 &&
      data.contactPerson is string &&
      data.contactPerson.size() >= 1 &&
      data.contactPerson.size() <= 100 &&
      data.phone is string &&
      data.phone.size() >= 6 &&
      data.phone.size() <= 20 &&
      data.email is string &&
      data.email.size() <= 254 &&
      isValidGstin(data.gstin) &&
      data.address is string &&
      data.address.size() >= 1 &&
      data.address.size() <= 300 &&
      data.state is string &&
      data.state.size() >= 1 &&
      data.state.size() <= 60 &&
      data.createdBy is string &&
      isValidId(data.createdBy) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidPurchase(data, purchaseId) {
      return data.keys().hasAll([
        'id',
        'orgId',
        'poNumber',
        'supplierId',
        'supplierName',
        'supplierGstin',
        'purchaseDate',
        'invoiceNumber',
        'paymentStatus',
        'receiptStatus',
        'itemCount',
        'subtotal',
        'gstTotal',
        'grandTotal',
        'notes',
        'createdBy',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'orgId',
        'poNumber',
        'supplierId',
        'supplierName',
        'supplierGstin',
        'purchaseDate',
        'invoiceNumber',
        'paymentStatus',
        'receiptStatus',
        'itemCount',
        'subtotal',
        'gstTotal',
        'grandTotal',
        'notes',
        'createdBy',
        'createdAt',
        'updatedAt',
        'receivedBy',
        'receivedAt'
      ]) &&
      data.id is string &&
      data.id == purchaseId &&
      isValidId(data.id) &&
      data.orgId == 'snackfactory' &&
      data.poNumber is string &&
      data.poNumber.size() >= 1 &&
      data.poNumber.size() <= 40 &&
      data.poNumber.matches('^[A-Z0-9\\-_]+$') &&
      data.supplierId is string &&
      isValidId(data.supplierId) &&
      data.supplierName is string &&
      data.supplierName.size() >= 1 &&
      data.supplierName.size() <= 120 &&
      isValidGstin(data.supplierGstin) &&
      data.purchaseDate is string &&
      data.purchaseDate.size() == 10 &&
      data.purchaseDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
      data.invoiceNumber is string &&
      data.invoiceNumber.size() <= 60 &&
      data.paymentStatus is string &&
      data.paymentStatus in ['Paid', 'Partially Paid', 'Unpaid'] &&
      data.receiptStatus is string &&
      data.receiptStatus in ['Ordered', 'Received', 'Cancelled'] &&
      data.itemCount is int &&
      data.itemCount >= 1 &&
      data.itemCount <= 100 &&
      (data.subtotal is int || data.subtotal is float) &&
      data.subtotal >= 0 &&
      data.subtotal <= 1000000000 &&
      (data.gstTotal is int || data.gstTotal is float) &&
      data.gstTotal >= 0 &&
      data.gstTotal <= 1000000000 &&
      (data.grandTotal is int || data.grandTotal is float) &&
      data.grandTotal >= 0 &&
      data.grandTotal <= 1000000000 &&
      data.notes is string &&
      data.notes.size() <= 500 &&
      data.createdBy is string &&
      isValidId(data.createdBy) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp &&
      (!('receivedBy' in data) || (data.receivedBy is string && isValidId(data.receivedBy))) &&
      (!('receivedAt' in data) || data.receivedAt is timestamp);
    }

    function isValidPurchaseItem(data, itemId) {
      return data.keys().hasAll([
        'id',
        'orgId',
        'purchaseId',
        'rawMaterialId',
        'materialName',
        'materialCode',
        'unit',
        'quantity',
        'unitPrice',
        'gstPercentage',
        'lineSubtotal',
        'lineGst',
        'lineTotal',
        'createdBy',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'orgId',
        'purchaseId',
        'rawMaterialId',
        'materialName',
        'materialCode',
        'unit',
        'quantity',
        'unitPrice',
        'gstPercentage',
        'lineSubtotal',
        'lineGst',
        'lineTotal',
        'createdBy',
        'createdAt',
        'updatedAt'
      ]) &&
      data.id is string &&
      data.id == itemId &&
      isValidId(data.id) &&
      data.orgId == 'snackfactory' &&
      data.purchaseId is string &&
      isValidId(data.purchaseId) &&
      data.rawMaterialId is string &&
      isValidId(data.rawMaterialId) &&
      data.materialName is string &&
      data.materialName.size() >= 1 &&
      data.materialName.size() <= 120 &&
      data.materialCode is string &&
      data.materialCode.size() >= 1 &&
      data.materialCode.size() <= 40 &&
      data.materialCode.matches('^[A-Z0-9\\-_]+$') &&
      data.unit is string &&
      data.unit in ['kg', 'litre', 'pieces'] &&
      (data.quantity is int || data.quantity is float) &&
      data.quantity > 0 &&
      data.quantity <= 100000000 &&
      (data.unitPrice is int || data.unitPrice is float) &&
      data.unitPrice >= 0 &&
      data.unitPrice <= 10000000 &&
      (data.gstPercentage is int || data.gstPercentage is float) &&
      data.gstPercentage >= 0 &&
      data.gstPercentage <= 28 &&
      (data.lineSubtotal is int || data.lineSubtotal is float) &&
      data.lineSubtotal >= 0 &&
      data.lineSubtotal <= 1000000000 &&
      (data.lineGst is int || data.lineGst is float) &&
      data.lineGst >= 0 &&
      data.lineGst <= 1000000000 &&
      (data.lineTotal is int || data.lineTotal is float) &&
      data.lineTotal >= 0 &&
      data.lineTotal <= 1000000000 &&
      data.createdBy is string &&
      isValidId(data.createdBy) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidBom(data, bomId) {
      return data.keys().hasAll([
        'id',
        'orgId',
        'bomCode',
        'productId',
        'productName',
        'productSku',
        'packetSize',
        'version',
        'batchSize',
        'status',
        'itemCount',
        'estimatedMaterialCost',
        'costPerUnit',
        'notes',
        'createdBy',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'orgId',
        'bomCode',
        'productId',
        'productName',
        'productSku',
        'packetSize',
        'version',
        'batchSize',
        'status',
        'itemCount',
        'estimatedMaterialCost',
        'costPerUnit',
        'notes',
        'createdBy',
        'createdAt',
        'updatedAt'
      ]) &&
      data.id is string &&
      data.id == bomId &&
      isValidId(data.id) &&
      data.orgId == 'snackfactory' &&
      data.bomCode is string &&
      data.bomCode.size() >= 1 &&
      data.bomCode.size() <= 40 &&
      data.bomCode.matches('^[A-Z0-9\\-_]+$') &&
      data.productId is string &&
      isValidId(data.productId) &&
      data.productName is string &&
      data.productName.size() >= 1 &&
      data.productName.size() <= 120 &&
      data.productSku is string &&
      data.productSku.size() >= 1 &&
      data.productSku.size() <= 40 &&
      data.productSku.matches('^[A-Z0-9\\-_]+$') &&
      data.packetSize is string &&
      data.packetSize.size() >= 1 &&
      data.packetSize.size() <= 30 &&
      data.version is int &&
      data.version >= 1 &&
      data.version <= 1000 &&
      (data.batchSize is int || data.batchSize is float) &&
      data.batchSize > 0 &&
      data.batchSize <= 10000000 &&
      data.status is string &&
      data.status in ['Active', 'Draft', 'Archived'] &&
      data.itemCount is int &&
      data.itemCount >= 1 &&
      data.itemCount <= 100 &&
      (data.estimatedMaterialCost is int || data.estimatedMaterialCost is float) &&
      data.estimatedMaterialCost >= 0 &&
      data.estimatedMaterialCost <= 1000000000 &&
      (data.costPerUnit is int || data.costPerUnit is float) &&
      data.costPerUnit >= 0 &&
      data.costPerUnit <= 100000000 &&
      data.notes is string &&
      data.notes.size() <= 500 &&
      data.createdBy is string &&
      isValidId(data.createdBy) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidBomItem(data, itemId) {
      return data.keys().hasAll([
        'id',
        'orgId',
        'bomId',
        'rawMaterialId',
        'materialName',
        'materialCode',
        'stockUnit',
        'unit',
        'quantity',
        'unitCost',
        'estimatedCost',
        'createdBy',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'orgId',
        'bomId',
        'rawMaterialId',
        'materialName',
        'materialCode',
        'stockUnit',
        'unit',
        'quantity',
        'unitCost',
        'estimatedCost',
        'createdBy',
        'createdAt',
        'updatedAt'
      ]) &&
      data.id is string &&
      data.id == itemId &&
      isValidId(data.id) &&
      data.orgId == 'snackfactory' &&
      data.bomId is string &&
      isValidId(data.bomId) &&
      data.rawMaterialId is string &&
      isValidId(data.rawMaterialId) &&
      data.materialName is string &&
      data.materialName.size() >= 1 &&
      data.materialName.size() <= 120 &&
      data.materialCode is string &&
      data.materialCode.size() >= 1 &&
      data.materialCode.size() <= 40 &&
      data.materialCode.matches('^[A-Z0-9\\-_]+$') &&
      data.stockUnit is string &&
      data.stockUnit in ['kg', 'litre', 'pieces'] &&
      data.unit is string &&
      data.unit in ['kg', 'g', 'litre', 'ml', 'pieces'] &&
      (data.quantity is int || data.quantity is float) &&
      data.quantity > 0 &&
      data.quantity <= 100000000 &&
      (data.unitCost is int || data.unitCost is float) &&
      data.unitCost >= 0 &&
      data.unitCost <= 10000000 &&
      (data.estimatedCost is int || data.estimatedCost is float) &&
      data.estimatedCost >= 0 &&
      data.estimatedCost <= 1000000000 &&
      data.createdBy is string &&
      isValidId(data.createdBy) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidProductionOrder(data, orderId) {
      return data.keys().hasAll([
        'id', 'orgId', 'orderNumber', 'productId', 'productName', 'productSku', 'packetSize',
        'bomId', 'bomCode', 'bomVersion', 'bomBatchSize', 'plannedQuantity', 'expectedQuantity',
        'actualGoodQuantity', 'damagedQuantity', 'productionDate', 'supervisorUid', 'supervisorName',
        'status', 'materialsIssued', 'finishedGoodsPosted', 'notes', 'createdBy', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'orgId', 'orderNumber', 'productId', 'productName', 'productSku', 'packetSize',
        'bomId', 'bomCode', 'bomVersion', 'bomBatchSize', 'plannedQuantity', 'expectedQuantity',
        'actualGoodQuantity', 'damagedQuantity', 'productionDate', 'supervisorUid', 'supervisorName',
        'status', 'materialsIssued', 'finishedGoodsPosted', 'notes', 'createdBy', 'createdAt', 'updatedAt',
        'issuedBy', 'issuedAt', 'completedBy', 'completedAt'
      ]) &&
      data.id is string &&
      data.id == orderId &&
      isValidId(data.id) &&
      data.orgId == 'snackfactory' &&
      data.orderNumber is string &&
      data.orderNumber.size() >= 1 &&
      data.orderNumber.size() <= 40 &&
      data.orderNumber.matches('^[A-Z0-9\\-_]+$') &&
      data.productId is string &&
      isValidId(data.productId) &&
      data.productName is string &&
      data.productName.size() >= 1 &&
      data.productName.size() <= 120 &&
      data.productSku is string &&
      data.productSku.size() >= 1 &&
      data.productSku.size() <= 40 &&
      data.productSku.matches('^[A-Z0-9\\-_]+$') &&
      data.packetSize is string &&
      data.packetSize.size() >= 1 &&
      data.packetSize.size() <= 30 &&
      data.bomId is string &&
      isValidId(data.bomId) &&
      data.bomCode is string &&
      data.bomCode.size() >= 1 &&
      data.bomCode.size() <= 40 &&
      data.bomCode.matches('^[A-Z0-9\\-_]+$') &&
      data.bomVersion is int &&
      data.bomVersion >= 1 &&
      data.bomVersion <= 1000 &&
      (data.bomBatchSize is int || data.bomBatchSize is float) &&
      data.bomBatchSize > 0 &&
      data.bomBatchSize <= 10000000 &&
      (data.plannedQuantity is int || data.plannedQuantity is float) &&
      data.plannedQuantity > 0 &&
      data.plannedQuantity <= 100000000 &&
      (data.expectedQuantity is int || data.expectedQuantity is float) &&
      data.expectedQuantity > 0 &&
      data.expectedQuantity <= 100000000 &&
      (data.actualGoodQuantity is int || data.actualGoodQuantity is float) &&
      data.actualGoodQuantity >= 0 &&
      data.actualGoodQuantity <= 100000000 &&
      (data.damagedQuantity is int || data.damagedQuantity is float) &&
      data.damagedQuantity >= 0 &&
      data.damagedQuantity <= 100000000 &&
      data.productionDate is string &&
      data.productionDate.size() == 10 &&
      data.productionDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
      data.supervisorUid is string &&
      isValidId(data.supervisorUid) &&
      data.supervisorName is string &&
      data.supervisorName.size() >= 1 &&
      data.supervisorName.size() <= 100 &&
      data.status is string &&
      data.status in ['Planned', 'In Progress', 'Completed', 'Cancelled'] &&
      data.materialsIssued is bool &&
      data.finishedGoodsPosted is bool &&
      data.notes is string &&
      data.notes.size() <= 500 &&
      data.createdBy is string &&
      isValidId(data.createdBy) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp &&
      (!('issuedBy' in data) || (data.issuedBy is string && isValidId(data.issuedBy))) &&
      (!('issuedAt' in data) || data.issuedAt is timestamp) &&
      (!('completedBy' in data) || (data.completedBy is string && isValidId(data.completedBy))) &&
      (!('completedAt' in data) || data.completedAt is timestamp);
    }

    function isValidProductionConsumption(data, itemId) {
      return data.keys().hasAll([
        'id', 'orgId', 'productionOrderId', 'rawMaterialId', 'materialName', 'materialCode', 'unit',
        'expectedQuantity', 'issuedQuantity', 'actualConsumedQuantity', 'damagedMaterialQuantity',
