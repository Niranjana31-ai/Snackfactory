    function isValidDispatch(data, dispatchId) {
      return data.keys().hasAll([
        'id', 'orgId', 'dispatchNumber', 'salesOrderId', 'orderNumber', 'salesmanUid', 'salesmanName',
        'customerId', 'customerName', 'customerAddress', 'dispatchDate', 'vehicleNumber', 'driverName',
        'transporterName', 'ewayBillNumber', 'notes', 'isPartial', 'partialAuthorizedBy',
        'partialAuthorizedByName', 'itemCount', 'totalDispatchedQty', 'dispatchedBy',
        'dispatchedByName', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'orgId', 'dispatchNumber', 'salesOrderId', 'orderNumber', 'salesmanUid', 'salesmanName',
        'customerId', 'customerName', 'customerAddress', 'dispatchDate', 'vehicleNumber', 'driverName',
        'transporterName', 'ewayBillNumber', 'notes', 'isPartial', 'partialAuthorizedBy',
        'partialAuthorizedByName', 'itemCount', 'totalDispatchedQty', 'dispatchedBy',
        'dispatchedByName', 'createdAt'
      ]) &&
      data.id is string &&
      data.id == dispatchId &&
      isValidId(data.id) &&
      data.orgId == 'snackfactory' &&
