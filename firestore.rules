          ) ||
          (
            get(/databases/$(database)/documents/salesOrders/$(existing().salesOrderId)).data.status in ['Approved', 'Partially Dispatched'] &&
            incoming().dispatchedQuantity >= existing().dispatchedQuantity &&
            incoming().dispatchedQuantity <= existing().quantity &&
            hasRole(['Owner', 'Admin', 'Production Supervisor']) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'dispatchedQuantity',
              'updatedAt'
            ])
          )
        );

      allow delete: if isSignedIn() &&
        isValidId(itemId) &&
        (
          isOwnerOrAdmin() ||
          (hasRole(['Salesman']) && existing().salesmanUid == request.auth.uid)
        ) &&
        (
          !exists(/databases/$(database)/documents/salesOrders/$(existing().salesOrderId)) ||
          (
            get(/databases/$(database)/documents/salesOrders/$(existing().salesOrderId)).data.status in ['Draft', 'Pending Approval', 'Rejected', 'Cancelled'] &&
            get(/databases/$(database)/documents/salesOrders/$(existing().salesOrderId)).data.totalDispatchedQty == 0 &&
            get(/databases/$(database)/documents/salesOrders/$(existing().salesOrderId)).data.invoiceId == ''
          )
        );
    }

    match /invoices/{invoiceId} {
      allow get: if isValidId(invoiceId) && isSignedIn() && (
        hasRole(['Owner', 'Admin', 'Accountant/Auditor']) ||
        (hasRole(['Salesman']) && existing().salesmanUid == request.auth.uid)
      );

      allow list: if isSignedIn() && (
        (resource.data.orgId == 'snackfactory' && hasRole(['Owner', 'Admin', 'Accountant/Auditor'])) ||
        (hasRole(['Salesman']) && resource.data.salesmanUid == request.auth.uid)
      );

      allow create: if isSignedIn() &&
        isValidId(invoiceId) &&
        isValidInvoice(incoming(), invoiceId) &&
        incoming().amountPaid == 0 &&
        incoming().outstandingBalance == incoming().grandTotal &&
        incoming().paymentStatus == 'Unpaid' &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/salesOrders/$(incoming().salesOrderId)) &&
        get(/databases/$(database)/documents/salesOrders/$(incoming().salesOrderId)).data.status in ['Approved', 'Partially Dispatched', 'Dispatched'] &&
        get(/databases/$(database)/documents/salesOrders/$(incoming().salesOrderId)).data.invoiceId == '' &&
        getAfter(/databases/$(database)/documents/salesOrders/$(incoming().salesOrderId)).data.invoiceId == invoiceId &&
        hasRole(['Owner', 'Admin', 'Accountant/Auditor']);

      allow update: if isSignedIn() &&
        isValidId(invoiceId) &&
        isValidInvoice(incoming(), invoiceId) &&
        incoming().id == existing().id &&
        incoming().orgId == existing().orgId &&
        incoming().invoiceNumber == existing().invoiceNumber &&
        incoming().salesOrderId == existing().salesOrderId &&
        incoming().grandTotal == existing().grandTotal &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().amountPaid >= existing().amountPaid &&
        incoming().amountPaid <= existing().grandTotal &&
        incoming().outstandingBalance >= 0 &&
        incoming().outstandingBalance <= existing().grandTotal &&
        hasRole(['Owner', 'Admin', 'Accountant/Auditor']) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'amountPaid',
          'outstandingBalance',
          'paymentStatus',
          'updatedAt'
        ]);

      allow delete: if false;
    }

    match /invoiceItems/{itemId} {
      allow get: if isValidId(itemId) && isSignedIn() && (
        hasRole(['Owner', 'Admin', 'Accountant/Auditor']) ||
        (hasRole(['Salesman']) && existing().salesmanUid == request.auth.uid)
      );

      allow list: if isSignedIn() && (
        (resource.data.orgId == 'snackfactory' && hasRole(['Owner', 'Admin', 'Accountant/Auditor'])) ||
        (hasRole(['Salesman']) && resource.data.salesmanUid == request.auth.uid)
      );

      allow create: if isSignedIn() &&
        isValidId(itemId) &&
        isValidInvoiceItem(incoming(), itemId) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        (
          exists(/databases/$(database)/documents/invoices/$(incoming().invoiceId)) ||
          existsAfter(/databases/$(database)/documents/invoices/$(incoming().invoiceId))
        ) &&
        hasRole(['Owner', 'Admin', 'Accountant/Auditor']);

      allow update, delete: if false;
    }

    match /dispatches/{dispatchId} {
      allow get: if isValidId(dispatchId) && isSignedIn() && (
        hasRole(['Owner', 'Admin', 'Production Supervisor', 'Accountant/Auditor']) ||
        (hasRole(['Salesman']) && existing().salesmanUid == request.auth.uid)
      );

      allow list: if isSignedIn() && (
        (resource.data.orgId == 'snackfactory' && hasRole(['Owner', 'Admin', 'Production Supervisor', 'Accountant/Auditor'])) ||
        (hasRole(['Salesman']) && resource.data.salesmanUid == request.auth.uid)
      );

      allow create: if isSignedIn() &&
        isValidId(dispatchId) &&
        isValidDispatch(incoming(), dispatchId) &&
        incoming().dispatchedBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/salesOrders/$(incoming().salesOrderId)) &&
        get(/databases/$(database)/documents/salesOrders/$(incoming().salesOrderId)).data.status in ['Approved', 'Partially Dispatched'] &&
        (
          isOwnerOrAdmin() ||
          (hasRole(['Production Supervisor']) && incoming().isPartial == false)
        );

      allow update, delete: if false;
    }

    match /dispatchItems/{itemId} {
      allow get: if isValidId(itemId) && isSignedIn() && (
        hasRole(['Owner', 'Admin', 'Production Supervisor', 'Accountant/Auditor']) ||
        (hasRole(['Salesman']) && existing().salesmanUid == request.auth.uid)
      );

      allow list: if isSignedIn() && (
        (resource.data.orgId == 'snackfactory' && hasRole(['Owner', 'Admin', 'Production Supervisor', 'Accountant/Auditor'])) ||
        (hasRole(['Salesman']) && resource.data.salesmanUid == request.auth.uid)
      );

      allow create: if isSignedIn() &&
        isValidId(itemId) &&
        isValidDispatchItem(incoming(), itemId) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        (
          exists(/databases/$(database)/documents/dispatches/$(incoming().dispatchId)) ||
          existsAfter(/databases/$(database)/documents/dispatches/$(incoming().dispatchId))
        ) &&
        hasRole(['Owner', 'Admin', 'Production Supervisor']);

      allow update, delete: if false;
    }

    match /payments/{paymentId} {
      allow get: if isValidId(paymentId) && isSignedIn() && (
        hasRole(['Owner', 'Admin', 'Accountant/Auditor']) ||
        (hasRole(['Salesman']) && existing().salesmanUid == request.auth.uid)
      );

      allow list: if isSignedIn() && (
        (resource.data.orgId == 'snackfactory' && hasRole(['Owner', 'Admin', 'Accountant/Auditor'])) ||
        (hasRole(['Salesman']) && resource.data.salesmanUid == request.auth.uid)
      );

      allow create: if isSignedIn() &&
        isValidId(paymentId) &&
        isValidPayment(incoming(), paymentId) &&
        incoming().recordedBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/invoices/$(incoming().invoiceId)) &&
        incoming().amount <= get(/databases/$(database)/documents/invoices/$(incoming().invoiceId)).data.outstandingBalance &&
        getAfter(/databases/$(database)/documents/invoices/$(incoming().invoiceId)).data.outstandingBalance >= 0 &&
        hasRole(['Owner', 'Admin', 'Accountant/Auditor']);

      allow update, delete: if false;
    }

    match /productionCostings/{costingId} {
      allow get: if isValidId(costingId) && hasRole([
        'Owner',
        'Admin',
        'Production Supervisor',
        'Accountant/Auditor'
      ]);

      allow list: if isSignedIn() &&
        resource.data.orgId == 'snackfactory' &&
        hasRole([
          'Owner',
          'Admin',
          'Production Supervisor',
          'Accountant/Auditor'
        ]);

      allow create: if isSignedIn() &&
        isValidId(costingId) &&
        isValidProductionCosting(incoming(), costingId) &&
        incoming().recordedBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/productionOrders/$(incoming().productionOrderId)) &&
        hasRole(['Owner', 'Admin', 'Accountant/Auditor']);

      allow update: if isSignedIn() &&
        isValidId(costingId) &&
        isValidProductionCosting(incoming(), costingId) &&
        incoming().id == existing().id &&
        incoming().orgId == existing().orgId &&
        incoming().productionOrderId == existing().productionOrderId &&
        incoming().productId == existing().productId &&
        incoming().createdAt == existing().createdAt &&
        incoming().recordedBy == request.auth.uid &&
        incoming().updatedAt == request.time &&
        hasRole(['Owner', 'Admin', 'Accountant/Auditor']) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'labourCost',
          'gasElectricityCost',
          'otherExpenses',
          'notes',
          'recordedBy',
          'recordedByName',
          'updatedAt'
        ]);

      allow delete: if isSignedIn() &&
        isValidId(costingId) &&
        hasRole(['Owner', 'Admin', 'Accountant/Auditor']);
    }

    match /auditLogs/{logId} {
      allow get: if isValidId(logId) && hasRole([
        'Owner',
        'Admin',
        'Accountant/Auditor'
      ]);

      allow list: if isSignedIn() &&
        resource.data.orgId == 'snackfactory' &&
        hasRole([
          'Owner',
          'Admin',
          'Accountant/Auditor'
        ]);

      allow create: if isSignedIn() &&
        isValidId(logId) &&
        isValidAuditLog(incoming(), logId) &&
        incoming().userUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        hasRole([
          'Owner',
          'Admin',
          'Salesman',
          'Production Supervisor',
          'Accountant/Auditor'
        ]);

      allow update, delete: if false;
    }
  }
}
