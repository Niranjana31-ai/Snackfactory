      (data.rate is int || data.rate is float) &&
      data.rate >= 0 &&
      data.rate <= 10000000 &&
      (data.taxableValue is int || data.taxableValue is float) &&
      data.taxableValue >= 0 &&
      data.taxableValue <= 1000000000 &&
      (data.gstPercentage is int || data.gstPercentage is float) &&
      data.gstPercentage >= 0 &&
