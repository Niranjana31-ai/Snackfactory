      data.paymentDate is string &&
      data.paymentDate.size() == 10 &&
      data.paymentDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
      (data.amount is int || data.amount is float) &&
      data.amount > 0 &&
      data.amount <= 1000000000 &&
      data.paymentMethod is string &&
      data.paymentMethod in ['UPI', 'NEFT/RTGS', 'Bank Transfer', 'Cheque', 'Cash'] &&
      data.referenceNumber is string &&
      data.referenceNumber.size() >= 1 &&
      data.referenceNumber.size() <= 80 &&
      data.notes is string &&
      data.notes.size() <= 300 &&
      data.recordedBy is string &&
      isValidId(data.recordedBy) &&
      data.recordedByName is string &&
      data.recordedByName.size() >= 1 &&
      data.recordedByName.size() <= 100 &&
      data.createdAt is timestamp;
    }

    function isValidProductionCosting(data, costingId) {
      return data.keys().hasAll([
        'id', 'orgId', 'productionOrderId', 'orderNumber', 'productId', 'productName', 'productionDate',
        'labourCost', 'gasElectricityCost', 'otherExpenses', 'notes', 'recordedBy', 'recordedByName',
        'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'orgId', 'productionOrderId', 'orderNumber', 'productId', 'productName', 'productionDate',
        'labourCost', 'gasElectricityCost', 'otherExpenses', 'notes', 'recordedBy', 'recordedByName',
        'createdAt', 'updatedAt'
      ]) &&
      data.id is string &&
      data.id == costingId &&
      isValidId(data.id) &&
      data.orgId == 'snackfactory' &&
      data.productionOrderId is string &&
      data.productionOrderId == costingId &&
      isValidId(data.productionOrderId) &&
      data.orderNumber is string &&
      data.orderNumber.size() >= 1 &&
      data.orderNumber.size() <= 40 &&
      data.orderNumber.matches('^[A-Z0-9\\-_]+$') &&
      data.productId is string &&
      isValidId(data.productId) &&
      data.productName is string &&
      data.productName.size() >= 1 &&
      data.productName.size() <= 120 &&
      data.productionDate is string &&
      data.productionDate.size() == 10 &&
      data.productionDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
      (data.labourCost is int || data.labourCost is float) &&
      data.labourCost >= 0 &&
      data.labourCost <= 100000000 &&
      (data.gasElectricityCost is int || data.gasElectricityCost is float) &&
      data.gasElectricityCost >= 0 &&
      data.gasElectricityCost <= 100000000 &&
      (data.otherExpenses is int || data.otherExpenses is float) &&
      data.otherExpenses >= 0 &&
