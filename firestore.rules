      data.packetSize.size() >= 1 &&
      data.packetSize.size() <= 30 &&
      (data.orderedQuantity is int || data.orderedQuantity is float) &&
      data.orderedQuantity > 0 &&
      data.orderedQuantity <= 100000000 &&
      (data.dispatchedQuantity is int || data.dispatchedQuantity is float) &&
      data.dispatchedQuantity > 0 &&
      data.dispatchedQuantity <= data.orderedQuantity &&
      data.createdBy is string &&
      isValidId(data.createdBy) &&
      data.createdAt is timestamp;
    }

    function isValidPayment(data, paymentId) {
      return data.keys().hasAll([
        'id', 'orgId', 'receiptNumber', 'invoiceId', 'invoiceNumber', 'salesOrderId', 'orderNumber',
        'salesmanUid', 'customerId', 'customerName', 'paymentDate', 'amount', 'paymentMethod',
