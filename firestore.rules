    function isValidAuditLog(data, logId) {
      return data.keys().hasAll([
        'id', 'orgId', 'action', 'module', 'recordId', 'recordLabel', 'details',
        'userUid', 'userName', 'userRole', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'orgId', 'action', 'module', 'recordId', 'recordLabel', 'details',
        'userUid', 'userName', 'userRole', 'createdAt'
      ]) &&
      data.id is string &&
      data.id == logId &&
      isValidId(data.id) &&
      data.orgId == 'snackfactory' &&
      data.action is string &&
      data.action.size() >= 1 &&
      data.action.size() <= 80 &&
      data.module is string &&
      data.module.size() >= 1 &&
      data.module.size() <= 60 &&
      data.recordId is string &&
      data.recordId.size() >= 1 &&
      data.recordId.size() <= 132 &&
      data.recordLabel is string &&
      data.recordLabel.size() >= 1 &&
      data.recordLabel.size() <= 120 &&
      data.details is string &&
      data.details.size() >= 1 &&
      data.details.size() <= 500 &&
      data.userUid is string &&
      isValidId(data.userUid) &&
      data.userName is string &&
      data.userName.size() >= 1 &&
      data.userName.size() <= 100 &&
      isValidRole(data.userRole) &&
      data.createdAt is timestamp;
    }

    match /system/{docId} {
      allow get: if isSignedIn() && docId == 'bootstrap';

      allow create: if isSignedIn() &&
        docId == 'bootstrap' &&
        !exists(/databases/$(database)/documents/system/bootstrap) &&
        incoming().keys().hasAll(['initialized', 'ownerUid', 'createdAt']) &&
        incoming().keys().hasOnly(['initialized', 'ownerUid', 'createdAt']) &&
        incoming().initialized == true &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        existsAfter(/databases/$(database)/documents/users/$(request.auth.uid));

      allow update, delete: if false;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (
        request.auth.uid == userId || isOwnerOrAdmin()
      );

      allow list: if isSignedIn() && (
        resource.data.uid == request.auth.uid || isOwnerOrAdmin()
      );

      allow create: if isSignedIn() &&
        isValidId(userId) &&
        isValidUser(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        incoming().lastLoginAt == request.time &&
        (
          (
            request.auth.uid == userId &&
            'username' in incoming() &&
            incoming().role == 'Owner' &&
            incoming().status == 'Active' &&
            !exists(/databases/$(database)/documents/system/bootstrap) &&
            existsAfter(/databases/$(database)/documents/system/bootstrap)
          ) ||
          (
            isOwnerOrAdmin() &&
            'username' in incoming()
          )
        );

      allow update: if isSignedIn() &&
        isValidId(userId) &&
        isValidUser(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            request.auth.uid == userId &&
            incoming().role == existing().role &&
            incoming().status == existing().status &&
            incoming().email == existing().email &&
            (!('lastLoginAt' in incoming().diff(existing()).affectedKeys()) || incoming().lastLoginAt == request.time) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName',
              'photoURL',
              'department',
              'updatedAt',
              'lastLoginAt'
            ])
          ) ||
          (
            isOwnerOrAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'role',
              'department',
              'status',
              'displayName',
              'updatedAt'
            ])
          )
        );

      allow delete: if isSignedIn() &&
        isValidId(userId) &&
        isOwnerOrAdmin() &&
        request.auth.uid != userId;
    }

    match /products/{productId} {
      allow get: if isValidId(productId) && hasRole([
        'Owner',
        'Admin',
        'Salesman',
        'Production Supervisor',
        'Accountant/Auditor'
      ]);

      allow list: if isSignedIn() &&
        resource.data.orgId == 'snackfactory' &&
        hasRole([
          'Owner',
          'Admin',
          'Salesman',
          'Production Supervisor',
          'Accountant/Auditor'
        ]);

      allow create: if isSignedIn() &&
        isValidId(productId) &&
        isValidProduct(incoming(), productId) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isOwnerOrAdmin();

      allow update: if isSignedIn() &&
        isValidId(productId) &&
        isValidProduct(incoming(), productId) &&
        incoming().id == existing().id &&
        incoming().orgId == existing().orgId &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isOwnerOrAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'sku',
          'category',
          'description',
          'packetSize',
          'sellingPrice',
          'gstPercentage',
          'hsnCode',
          'status',
          'updatedAt'
        ]);

      allow delete: if isSignedIn() &&
        isValidId(productId) &&
        isOwnerOrAdmin();
    }

    match /rawMaterials/{materialId} {
      allow get: if isValidId(materialId) && hasRole([
        'Owner',
        'Admin',
        'Production Supervisor',
        'Accountant/Auditor'
      ]);

      allow list: if isSignedIn() &&
        resource.data.orgId == 'snackfactory' &&
        hasRole([
          'Owner',
          'Admin',
          'Production Supervisor',
          'Accountant/Auditor'
        ]);

      allow create: if isSignedIn() &&
        isValidId(materialId) &&
        isValidRawMaterial(incoming(), materialId) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        hasRole(['Owner', 'Admin', 'Production Supervisor']);

      allow update: if isSignedIn() &&
        isValidId(materialId) &&
        isValidRawMaterial(incoming(), materialId) &&
        incoming().id == existing().id &&
        incoming().orgId == existing().orgId &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        hasRole(['Owner', 'Admin', 'Production Supervisor']) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'materialCode',
          'category',
          'unit',
          'openingStock',
          'currentStock',
          'purchasePrice',
          'minimumStockLevel',
          'updatedAt'
        ]);

      allow delete: if isSignedIn() &&
        isValidId(materialId) &&
        hasRole(['Owner', 'Admin', 'Production Supervisor']);
    }

    match /customers/{customerId} {
      allow get: if isValidId(customerId) && hasRole([
        'Owner',
        'Admin',
        'Salesman',
        'Accountant/Auditor'
      ]);

      allow list: if isSignedIn() &&
        resource.data.orgId == 'snackfactory' &&
        hasRole([
          'Owner',
          'Admin',
          'Salesman',
          'Accountant/Auditor'
        ]);

      allow create: if isSignedIn() &&
        isValidId(customerId) &&
        isValidCustomer(incoming(), customerId) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        hasRole(['Owner', 'Admin', 'Salesman']);

      allow update: if isSignedIn() &&
        isValidId(customerId) &&
        isValidCustomer(incoming(), customerId) &&
        incoming().id == existing().id &&
        incoming().orgId == existing().orgId &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        hasRole(['Owner', 'Admin', 'Salesman']) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'contactPerson',
          'phone',
          'email',
          'gstin',
          'billingAddress',
          'state',
          'stateCode',
          'customerType',
          'updatedAt'
        ]);

      allow delete: if isSignedIn() &&
        isValidId(customerId) &&
        isOwnerOrAdmin();
    }

    match /suppliers/{supplierId} {
      allow get: if isValidId(supplierId) && hasRole([
        'Owner',
        'Admin',
        'Production Supervisor',
        'Accountant/Auditor'
      ]);

      allow list: if isSignedIn() &&
        resource.data.orgId == 'snackfactory' &&
        hasRole([
          'Owner',
          'Admin',
          'Production Supervisor',
          'Accountant/Auditor'
        ]);

      allow create: if isSignedIn() &&
        isValidId(supplierId) &&
        isValidSupplier(incoming(), supplierId) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        hasRole(['Owner', 'Admin', 'Production Supervisor']);

      allow update: if isSignedIn() &&
        isValidId(supplierId) &&
        isValidSupplier(incoming(), supplierId) &&
        incoming().id == existing().id &&
        incoming().orgId == existing().orgId &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        hasRole(['Owner', 'Admin', 'Production Supervisor']) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'contactPerson',
          'phone',
          'email',
          'gstin',
          'address',
          'state',
          'updatedAt'
        ]);

      allow delete: if isSignedIn() &&
        isValidId(supplierId) &&
        isOwnerOrAdmin();
    }

    match /purchases/{purchaseId} {
      allow get: if isValidId(purchaseId) && hasRole([
        'Owner',
        'Admin',
        'Production Supervisor',
        'Accountant/Auditor'
      ]);

      allow list: if isSignedIn() &&
        resource.data.orgId == 'snackfactory' &&
        hasRole([
          'Owner',
          'Admin',
          'Production Supervisor',
          'Accountant/Auditor'
        ]);

      allow create: if isSignedIn() &&
        isValidId(purchaseId) &&
        isValidPurchase(incoming(), purchaseId) &&
        incoming().receiptStatus == 'Ordered' &&
        !('receivedBy' in incoming()) &&
        !('receivedAt' in incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/suppliers/$(incoming().supplierId)) &&
        hasRole(['Owner', 'Admin', 'Production Supervisor']);

      allow update: if isSignedIn() &&
        isValidId(purchaseId) &&
        isValidPurchase(incoming(), purchaseId) &&
        incoming().id == existing().id &&
        incoming().orgId == existing().orgId &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        hasRole(['Owner', 'Admin', 'Production Supervisor']) &&
        (
          (
            existing().receiptStatus == 'Ordered' &&
            incoming().receiptStatus == 'Ordered' &&
            !('receivedBy' in incoming()) &&
            !('receivedAt' in incoming()) &&
            exists(/databases/$(database)/documents/suppliers/$(incoming().supplierId)) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'poNumber',
              'supplierId',
              'supplierName',
              'supplierGstin',
              'purchaseDate',
              'invoiceNumber',
              'paymentStatus',
